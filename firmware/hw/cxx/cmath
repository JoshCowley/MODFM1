// Minimal <cmath> for JieLi's pi32v2 clang 4.0.1 (no C++ standard library): the C maths functions, also in std.
#pragma once
#include <math.h>
// C++'s float overloads (the standard <cmath> has them): without these, fabs(x) on a float would compute in double,
// which the FM-1's single-precision FPU does in software
inline float fabs(float x) { return fabsf(x); }
inline float sqrt(float x) { return sqrtf(x); }
inline float floor(float x) { return floorf(x); }
inline float ceil(float x) { return ceilf(x); }
inline float exp(float x) { return expf(x); }
inline float log(float x) { return logf(x); }
inline float log10(float x) { return log10f(x); }
inline float log2(float x) { return log2f(x); }
inline float pow(float x, float y) { return powf(x, y); }
inline float sin(float x) { return sinf(x); }
inline float cos(float x) { return cosf(x); }
inline float tan(float x) { return tanf(x); }
inline float tanh(float x) { return tanhf(x); }
inline float atan(float x) { return atanf(x); }
inline float atan2(float y, float x) { return atan2f(y, x); }
inline float fmod(float x, float y) { return fmodf(x, y); }
namespace std {
using ::sqrt; using ::sqrtf; using ::sin; using ::sinf; using ::cos; using ::cosf; using ::tan; using ::tanf;
using ::exp; using ::expf; using ::log; using ::logf; using ::pow; using ::powf; using ::fabs; using ::fabsf;
using ::floor; using ::floorf; using ::ceil; using ::ceilf; using ::fmod; using ::fmodf; using ::atan; using ::atanf;
using ::atan2; using ::atan2f; using ::tanh; using ::tanhf; using ::log10; using ::log10f; using ::log2; using ::log2f;
inline float abs(float x) { return fabsf(x); }
inline double abs(double x) { return fabs(x); }
}
